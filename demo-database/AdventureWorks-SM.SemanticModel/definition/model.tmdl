model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-HK
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["SalesLT Address","SalesLT CustomerAddress","SalesLT SalesOrderHeader","SalesLT Customer","SalesLT Product","SalesLT ProductCategory","SalesLT ProductDescription","SalesLT ProductModel","SalesLT ProductModelProductDescription","SalesLT SalesOrderDetail","SalesLT vGetAllCategories","SalesLT vProductAndDescription","SalesLT vProductModelCatalogDescription"]

annotation PBI_ProTooling = ["CopilotTooling"]

ref table 'SalesLT Address'
ref table 'SalesLT CustomerAddress'
ref table 'SalesLT SalesOrderHeader'
ref table 'SalesLT Customer'
ref table 'SalesLT Product'
ref table 'SalesLT ProductCategory'
ref table 'SalesLT ProductDescription'
ref table 'SalesLT ProductModel'
ref table 'SalesLT ProductModelProductDescription'
ref table 'SalesLT SalesOrderDetail'
ref table 'SalesLT vGetAllCategories'
ref table 'SalesLT vProductAndDescription'
ref table 'SalesLT vProductModelCatalogDescription'

ref cultureInfo en-US

